#!/usr/bin/env node
import { readFileSync, readdirSync, writeFileSync } from "node:fs";
import { join } from "node:path";

const ROOT = "D:/Study/Project/QLLaw-main/apps/web/src/components/documents";

function listBmPanelFiles(dir) {
  return readdirSync(dir)
    .filter((f) => /^bm-\d{3}-form-inputs\.tsx$/.test(f))
    .map((f) => join(dir, f));
}

function findMatchingBrace(src, startIdx) {
  let depth = 0;
  for (let i = startIdx; i < src.length; i++) {
    if (src[i] === "{") depth++;
    else if (src[i] === "}") { depth--; if (depth === 0) return i; }
  }
  return -1;
}

function migrateFile(path) {
  let src = readFileSync(path, "utf8");
  const orig = src;

  const URL = "`${API_BASE_URL}/documents/generated/${documentId}/form-inputs`";
  const urlIdx = src.indexOf(URL);
  if (urlIdx === -1) return { skipped: true };

  const awaitFetchIdx = src.lastIndexOf("await fetch(", urlIdx);
  if (awaitFetchIdx === -1) return { skipped: true };

  let i = urlIdx + 1;
  while (i < src.length && src[i] !== "`") i++;
  const closeBacktick = i;
  i = closeBacktick + 1;
  while (i < src.length && (/\s/.test(src[i]) || src[i] === ",")) i++;
  if (src[i] !== "{") return { skipped: true };
  const initOpen = i;
  const initClose = findMatchingBrace(src, initOpen);
  if (initClose === -1) return { skipped: true };

  const initInner = src.slice(initOpen + 1, initClose);
  const bodyMatch = initInner.match(/body\s*:\s*JSON\.stringify\s*\(\s*([\s\S]*?)\s*\)\s*,?\s*$/);
  if (!bodyMatch) return { skipped: true };
  const bodyExpr = bodyMatch[1].trim();

  i = initClose + 1;
  while (i < src.length && (/\s/.test(src[i]) || src[i] === ",")) i++;
  const fetchClose = i;

  // Calculate indentation — only leading whitespace
  const lastNewline = src.lastIndexOf("\n", awaitFetchIdx - 1);
  const lineStart = lastNewline + 1;
  const lineContent = src.slice(lineStart, awaitFetchIdx);
  const indentMatch = lineContent.match(/^(\s*)/);
  const indent = indentMatch ? indentMatch[1] : "";

  // === Step 1: Replace from awaitFetchIdx (start of "await") to fetchClose+1 (past ')')
  // This removes "const response = await fetch(...)" and replaces with "await saveDocumentFormInputs(...)"
  const replacement = indent + "await saveDocumentFormInputs(documentId, " + bodyExpr + ");";
  console.log("  replacement:", JSON.stringify(replacement));
  src = src.slice(0, awaitFetchIdx) + replacement + src.slice(fetchClose + 1);
  console.log("  src.slice(0,20):", JSON.stringify(src.slice(0, 20)));
  console.log("  src.indexOf(replacement):", src.indexOf(replacement));

  // === Step 2: Remove if-block and payload lines
  const newReplacementIdx = src.indexOf(replacement);
  if (newReplacementIdx === -1) return { skipped: true };
  const afterReplacement = newReplacementIdx + replacement.length;

  let remaining = src.slice(afterReplacement);
  let consumed = 0;

  let j = 0;
  while (j < remaining.length && (/\s/.test(remaining[j]) || remaining[j] === ";")) j++;
  if (remaining.slice(j).match(/^if\s*\(\s*!\s*response\.ok\s*\)/)) {
    let k = j;
    while (k < remaining.length && remaining[k] !== "{") k++;
    const braceStart = k;
    const braceEnd = findMatchingBrace(remaining, braceStart);
    if (braceEnd !== -1) {
      consumed = braceEnd + 1;
      while (consumed < remaining.length && (/\s/.test(remaining[consumed]) || remaining[consumed] === ";")) consumed++;
    }
  }

  const savedMatch = remaining.slice(consumed).match(
    /^[ \t]*const\s+\w+\s*=\s*\(\s*await\s+response\.json\(\)\s*\)[^;]*;[ \t]*(?:\r?\n)?/,
  );
  if (savedMatch) {
    consumed += savedMatch[0].length;
    while (consumed < remaining.length && (/\s/.test(remaining[consumed]) || remaining[consumed] === ";")) consumed++;
    const setFormMatch = remaining.slice(consumed).match(
      /^[ \t]*setForm\s*\(\s*normalizeFormInputs\s*\(\s*\w+\s*\)\s*\)\s*;[ \t]*(?:\r?\n)?/,
    );
    if (setFormMatch) {
      consumed += setFormMatch[0].length;
      while (consumed < remaining.length && (/\s/.test(remaining[consumed]) || remaining[consumed] === ";")) consumed++;
    }
  }

  src = src.slice(0, afterReplacement) + remaining.slice(consumed);

  // === Step 3: Fix imports
  const importRe = /import\s*\{([^}]*)\}\s*from\s*["']@\/lib\/document-form-api["']\s*;/;
  if (importRe.test(src)) {
    const m = src.match(importRe);
    const names = m[1].split(",").map((s) => s.trim()).filter(Boolean);
    if (!names.includes("saveDocumentFormInputs")) {
      names.push("saveDocumentFormInputs");
      names.sort();
      src = src.replace(importRe, `import { ${names.join(", ")} } from "@/lib/document-form-api";`);
    }
  } else {
    const firstImport = src.match(/^import\s+[^;]+;\s*$/m);
    if (firstImport) {
      const insertAt = firstImport.index + firstImport[0].length;
      src = src.slice(0, insertAt) + "\nimport { saveDocumentFormInputs } from \"@/lib/document-form-api\";" + src.slice(insertAt);
    }
  }

  // === Step 4: Remove unused API_BASE_URL
  const apiBaseCount = (src.match(/\bAPI_BASE_URL\b/g) || []).length;
  if (apiBaseCount <= 1) {
    src = src.replace(/^const\s+API_BASE_URL\s*=\s*[\s\S]*?;\s*\n/m, "");
  }

  // === Step 5: Remove orphaned response.text() calls
  src = src.replace(/^\s*const\s+\w+\s*=\s*await\s+response\.text\(\)\s*;\s*\n/m, "");

  if (src !== orig) {
    writeFileSync(path, src, "utf8");
    return { migrated: true };
  }
  return { skipped: true };
}

const files = listBmPanelFiles(ROOT);
let migrated = 0, skipped = 0, errors = 0;
for (const f of files) {
  try {
    const r = migrateFile(f);
    if (r.migrated) { migrated++; console.log("migrated " + f); }
    else skipped++;
  } catch (err) {
    errors++;
    console.error("ERROR " + f + ": " + err.message);
  }
}
console.log("\n" + migrated + " migrated, " + skipped + " skipped, " + errors + " errors.");
