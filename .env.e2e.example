# =============================================================
# QUANLYVKS E2E environment template
#
# Copy to `.env.e2e.local` for local Playwright/E2E testing.
# DO NOT commit .env.e2e.local or this file with real values.
# Use Clerk test keys from Clerk Dashboard -> Developers -> API Keys.
# =============================================================

# ----- E2E Auth -----
# Email of an E2E test user that exists in Clerk + has linked DB identity
E2E_CLERK_USER_EMAIL=admin@example.test

# ----- Clerk Keys -----
# Use Clerk test keys. NEVER use sk_live_ keys.
# Get these from Clerk Dashboard -> Developers -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<CLERK_PUBLISHABLE_KEY>
CLERK_PUBLISHABLE_KEY=<CLERK_PUBLISHABLE_KEY>
CLERK_SECRET_KEY=<CLERK_SECRET_KEY>

# ----- Playwright -----
PLAYWRIGHT_BASE_URL=http://localhost:3000
