# =============================================================
# QUANLYVKS local development environment sample
#
# Copy to `.env` for local development only, then replace every
# `change-me-*` value. Do not commit real `.env` files.
# Production deploys must use a secret store and the checklist in:
# docs/auth/production-auth-hardening.md
# =============================================================

# ----- Database (MariaDB 11) -----
DATABASE_URL="mysql://quanlyvks:change-me-db-password@127.0.0.1:3307/quanlyvks?connection_limit=10"

# ----- MariaDB container (local pnpm db:up only) -----
MARIADB_IMAGE=mariadb:11
MARIADB_CONTAINER=quanlyvks-mariadb
MARIADB_HOST=127.0.0.1
MARIADB_HOST_PORT=3307
MARIADB_PORT=3306
MARIADB_USER=quanlyvks
MARIADB_PASSWORD=change-me-db-password
MARIADB_DATABASE=quanlyvks
MARIADB_ROOT_PASSWORD=change-me-root-password

# ----- API -----
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# WEB_ORIGIN is required in production and optional in local development.
# WEB_ORIGIN=http://localhost:3000
# REPO_ROOT=D:/Study/Project/QLLaw-main

# ----- DOCX renderer migration -----
# off: use the legacy renderer
# shadow: return legacy output, compare contract renderer in the background
# active: use approved contract-renderer templates only
DOCUMENT_RENDERER_MODE=off
DOCUMENT_RENDERER_CONTRACT_TEMPLATES=

# ----- Web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# BACKEND_ORIGIN=http://localhost:3001

# ----- Auth session cookie -----
AUTH_SESSION_COOKIE_NAME=qlv_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_DOMAIN=

# ----- Clerk Authentication -----
# Set these only in local `.env` / `.env.local` or a deployment secret store.
# Never commit real Clerk keys.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=<set-local-clerk-secret-key>
# CLERK_AUTHORIZED_PARTIES=https://your-app.example

# Clerk webhook:
# Route: POST /api/v1/auth/webhooks/clerk
# Secret comes from Clerk Dashboard -> Webhooks -> Signing secret.
# CLERK_WEBHOOK_SECRET=<set-local-clerk-webhook-secret>

# ----- Storage -----
STORAGE_ROOT=./storage

# ----- Seed -----
SEED_ADMIN_FULL_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-local-admin-password
SEED_ADMIN_POSITION=Quan tri he thong

# Optional limited staging test account. Disabled by default; never use a
# committed or shared default password.
SEED_TEST_ACCOUNT_ENABLED=false
# SEED_TEST_ACCOUNT_PASSWORD=<set-in-secret-store-only>

# Le Huy bootstrap admin. Set locally only; never commit a real value.
# SEED_LE_HUY_PASSWORD=<set-local-password>
# SEED_LE_HUY_EMAIL=admin@example.local
# SEED_LE_HUY_CLERK_USER_ID=user_xxxxxxxxxxxxx

SEED_AGENCY_NAME=Vien kiem sat
SEED_PARENT_AGENCY_NAME=
SEED_AGENCY_CODE=VKS-DEFAULT

# =============================================================
# Public local testing through Cloudflare Tunnel
# =============================================================
# Keep this false by default. It is allowed only with NODE_ENV=development.
# When true, local API cookies become Secure + SameSite=None for HTTPS tunnel
# browser testing. Production startup rejects TUNNEL_TEST=true.
TUNNEL_TEST=false

# Example tunnel test values:
# NODE_ENV=development
# TUNNEL_TEST=true
# WEB_ORIGIN=https://your-vercel-domain.vercel.app
# API_CORS_ORIGIN=https://your-vercel-domain.vercel.app
