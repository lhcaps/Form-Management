# =============================================================
# QUANLYVKS - biến môi trường mẫu (đã có giá trị mặc định an toàn)
# Copy thành `.env` (cùng cấp) và sửa lại cho phù hợp đơn vị thật.
# KHÔNG commit `.env` thật (đã nằm trong .gitignore).
# =============================================================

# ----- Database (MariaDB 11) -----
# Driver Prisma: @prisma/adapter-mariadb + mariadb
# Lưu ý: provider trong schema.prisma vẫn là "mysql" (Prisma 6 + MariaDB).
DATABASE_URL="mysql://quanlyvks:change-me@127.0.0.1:3307/quanlyvks?connection_limit=10"

# ----- MariaDB container (chỉ dùng cho pnpm db:up) -----
MARIADB_IMAGE=mariadb:11
MARIADB_CONTAINER=quanlyvks-mariadb
MARIADB_HOST=127.0.0.1
MARIADB_HOST_PORT=3307
MARIADB_PORT=3306
MARIADB_USER=quanlyvks
MARIADB_PASSWORD=change-me
MARIADB_DATABASE=quanlyvks
MARIADB_ROOT_PASSWORD=root-change-me

# ----- API -----
NODE_ENV=development
TZ=Asia/Ho_Chi_Minh
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
# Danh sách origin được phép, phân tách bằng dấu phẩy.
# Khi mở web từ máy khác trong LAN, thêm đúng origin của web, ví dụ:
# API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://26.200.36.171:3000
# Không dùng "*" trong production.
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# Tuỳ chọn: repo root chứa pnpm-workspace.yaml. Thường không cần đặt vì API tự dò.
# REPO_ROOT=D:/Study/Project/QLLaw-main

# ----- DOCX renderer migration -----
# off: chạy renderer legacy (mặc định an toàn)
# shadow: trả kết quả legacy, chạy renderer contract để so sánh
# active: template trong allow-list chạy renderer contract, không fallback ngầm
DOCUMENT_RENDERER_MODE=off
# Danh sách template đã duyệt, phân tách bằng dấu phẩy. Để rỗng ở D.2.1.
DOCUMENT_RENDERER_CONTRACT_TEMPLATES=

# ----- Web -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# BACKEND_ORIGIN=http://localhost:3001  # nếu muốn dùng Next.js rewrite /api/* -> backend

# ----- Auth (session cookie — legacy, phased out in PR-7) -----
AUTH_SESSION_COOKIE_NAME=qlv_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=false  # đặt true khi chạy HTTPS

# ----- Clerk Authentication (PR-1: Clerk Foundation) -----
# Get these from: https://dashboard.clerk.com → API Keys
# Development: sk_test_... / pk_test_...
# NEVER commit real keys. Copy this section to .env.local with real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clerk redirect URLs (must match URLs in Clerk Dashboard → Redirect URLs)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook (PR-2B — Clerk DB Identity Projection)
# Get from: https://dashboard.clerk.com → Webhooks → signing secret
# sv_ prefix = Svix webhook signing secret
# CLERK_WEBHOOK_SECRET=sv_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Storage -----
# Đường dẫn tới folder storage (chứa templates/docx, generated, ...)
# Mặc định: <repo-root>/storage
STORAGE_ROOT=./storage

# ----- Seed -----
# Tên admin mặc định seed cho officials (nếu DB rỗng)
SEED_ADMIN_FULL_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_POSITION=Quan tri he thong

# Agency mặc định cho seed
SEED_AGENCY_NAME=Viện kiểm sát
SEED_PARENT_AGENCY_NAME=
SEED_AGENCY_CODE=VKS-DEFAULT

# =============================================================
# PUBLIC TESTING VIA CLOUDFLARE TUNNEL (tùy chọn)
# Dùng khi expose local API qua Cloudflare Tunnel để test public.
# Chi tiết: docs/deploy/FREE-PUBLIC-TESTING-VIA-VERCEL-TUNNEL.md
# =============================================================

# Bật chế độ test cross-origin:
#   - Cookie SameSite=None, Secure=true (hoạt động với browser trên tunnel URL)
#   - Bỏ qua kiểm tra SEED_ADMIN_PASSWORD (không cần đổi admin123)
#   - Vẫn kiểm tra CORS không dùng wildcard
TUNNEL_TEST=true

# Origin của Vercel frontend (sau khi deploy web)
WEB_ORIGIN=https://your-vercel-domain.vercel.app

# CORS allow-list — thêm Vercel domain
API_CORS_ORIGIN=https://your-vercel-domain.vercel.app
