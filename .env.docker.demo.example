# =============================================================
# QUANLYVKS Docker Demo / Staging environment — EXAMPLE FILE
#
# Copy to `.env.docker.demo` and fill in your Clerk test keys:
#   cp .env.docker.demo.example .env.docker.demo
#
# Classification: PRODUCTION_STACK_DEMO_AUTH_PASS
# Font policy:    DEMO_FONT_FALLBACK_ACTIVE
# Clerk:          DEMO_AUTH_PASS (pk_test_ / sk_test_ accepted)
# Webhook:        CLERK_WEBHOOK_OPTIONAL_FOR_DEMO
# =============================================================

# ----- MySQL (MariaDB 11) -----
MYSQL_ROOT_PASSWORD=demo-root-change-me
MYSQL_DATABASE=quanlyvks
MYSQL_USER=quanlyvks
MYSQL_PASSWORD=demo-db-change-me

# ----- Office-lite resource budgets -----
MYSQL_CPU_LIMIT=0.50
MYSQL_MEMORY_LIMIT=512m
MYSQL_PIDS_LIMIT=128
API_CPU_LIMIT=0.75
API_MEMORY_LIMIT=768m
API_PIDS_LIMIT=256
WEB_CPU_LIMIT=0.50
WEB_MEMORY_LIMIT=384m
WEB_PIDS_LIMIT=128

# ----- Backend (NestJS API) -----
NODE_ENV=production
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
TUNNEL_TEST=false

# Origins: localhost for demo
WEB_ORIGIN=http://localhost:3000
API_CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Cookie settings for local demo (no HTTPS required)
AUTH_SESSION_COOKIE_NAME=qlv_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# ----- Clerk (REPLACE with your test keys) -----
# Get from: https://dashboard.clerk.com → API Keys
CLERK_SECRET_KEY=replace-with-sk_test_your_key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-pk_test_your_key
# CLERK_WEBHOOK_SECRET is OPTIONAL when QLLAW_DOCKER_MODE=demo

# ----- Demo mode -----
QLLAW_DOCKER_MODE=demo

# ----- Font policy: fallback-allowed for demo -----
QLLAW_FONT_POLICY=fallback-allowed
QLLAW_REQUIRED_FONT_FAMILY=Times New Roman
QLLAW_TNR_FONT_DIR=./infra/fonts-fallback

# ----- Bootstrap seed (first run only) -----
SEED_ADMIN_FULL_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=demo-admin-change-me
SEED_ADMIN_POSITION=Quan tri he thong
SEED_DATA=false
SEED_TEST_ACCOUNT_ENABLED=false

# ----- Storage paths -----
STORAGE_ROOT=/app/storage
GENERATED_FILES_ROOT=/app/storage/generated
NORMALIZED_DOCX_ROOT=/app/storage/templates/normalized-docx

# ----- LibreOffice -----
LIBREOFFICE_PATH=/usr/bin/libreoffice

# ----- Document renderer -----
DOCUMENT_RENDERER_MODE=off

# ----- Swagger (enabled for demo inspection) -----
SWAGGER_ENABLED=true

# ----- Web -----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
