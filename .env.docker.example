# =============================================================
# QUANLYVKS - Staging / Production Docker environment
# Copy thành `.env.docker` (cùng cấp với docker-compose.prod.yml)
# KHÔNG commit .env.docker thật vào git.
# =============================================================

# ----- MySQL (MariaDB 11) -----
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=quanlyvks
MYSQL_USER=quanlyvks
MYSQL_PASSWORD=change-me
MYSQL_HOST_PORT=3306

# ----- Backend (NestJS API) -----
# Public URL of this container/service (used by Vercel frontend)
API_BASE_URL=http://localhost:3001

# Vercel frontend URL — used for CORS allow-list and session cookie (SameSite=None, Secure)
WEB_ORIGIN=https://your-vercel-domain.vercel.app

# Cookie auth
AUTH_SESSION_COOKIE_NAME=qlv_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# API CORS — set to WEB_ORIGIN so backend allows requests from Vercel
API_CORS_ORIGIN=https://your-vercel-domain.vercel.app

# Storage paths inside container
STORAGE_ROOT=/app/storage
GENERATED_FILES_ROOT=/app/storage/generated
NORMALIZED_DOCX_ROOT=/app/storage/templates/normalized-docx

# LibreOffice for PDF export (installed in api.Dockerfile)
LIBREOFFICE_PATH=/usr/bin/libreoffice

# Document renderer — "off" is safe for staging (no contract rendering)
DOCUMENT_RENDERER_MODE=off

# Optional: Swagger docs on staging
SWAGGER_ENABLED=true

# ----- Ports -----
API_PORT=3001
WEB_PORT=3000

# ----- Next.js Public (injected into Docker build) -----
# The web.Dockerfile reads this as a build ARG
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.com/api/v1
