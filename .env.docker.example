# =============================================================
# QUANLYVKS staging / production Docker environment sample
#
# Copy to `.env.docker` and replace every `replace-with-*` value before
# starting a production container. The API intentionally refuses obvious
# placeholders in production.
# =============================================================

# ----- MySQL (MariaDB 11) -----
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=quanlyvks
MYSQL_USER=quanlyvks
MYSQL_PASSWORD=replace-with-strong-db-password

# ----- Container resource budgets (override only after capacity planning) -----
MYSQL_CPU_LIMIT=1.00
MYSQL_MEMORY_LIMIT=1024m
MYSQL_PIDS_LIMIT=256
API_CPU_LIMIT=1.50
API_MEMORY_LIMIT=1536m
API_PIDS_LIMIT=512
WEB_CPU_LIMIT=0.75
WEB_MEMORY_LIMIT=768m
WEB_PIDS_LIMIT=256

# ----- Backend (NestJS API) -----
NODE_ENV=production
API_PORT=3001
API_GLOBAL_PREFIX=api/v1
API_BASE_URL=https://your-api-domain.example
TUNNEL_TEST=false

# Vercel/frontend origin. Required in production.
WEB_ORIGIN=https://your-app-domain.example
API_CORS_ORIGIN=https://your-app-domain.example

# Cookie auth for cross-origin frontend -> backend requests.
AUTH_SESSION_COOKIE_NAME=qlv_session
AUTH_SESSION_TTL_DAYS=14
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=none

# Clerk. Set real values in your deployment secret store.
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_WEBHOOK_SECRET=replace-with-clerk-webhook-secret
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
# CLERK_AUTHORIZED_PARTIES=https://your-app-domain.example

# Bootstrap seed. Use only for first deploy or controlled staging resets.
SEED_ADMIN_FULL_NAME=Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
SEED_ADMIN_POSITION=Quan tri he thong
SEED_DATA=false
SEED_TEST_ACCOUNT_ENABLED=false
# SEED_TEST_ACCOUNT_PASSWORD=<set-in-secret-store-only>
# SEED_LE_HUY_PASSWORD=<set-in-secret-store-only>
# SEED_LE_HUY_EMAIL=admin@example.local
# SEED_LE_HUY_CLERK_USER_ID=user_xxxxxxxxxxxxx

# Storage paths inside container.
STORAGE_ROOT=/app/storage
GENERATED_FILES_ROOT=/app/storage/generated
NORMALIZED_DOCX_ROOT=/app/storage/templates/normalized-docx

# LibreOffice for PDF export.
LIBREOFFICE_PATH=/usr/bin/libreoffice

# Document renderer. Keep "off" for staging unless a rollout explicitly enables it.
DOCUMENT_RENDERER_MODE=off

# Phase 8C: font policy for DOCX -> PDF rendering.
# QLLAW_FONT_POLICY=required          (production default; fail-closed on missing Times New Roman)
# QLLAW_FONT_POLICY=fallback-allowed  (dev/test only; explicit ack of metric-compatible fallback)
QLLAW_FONT_POLICY=required
QLLAW_REQUIRED_FONT_FAMILY=Times New Roman

# Phase 8C: operator-provided licensed Times New Roman directory on the
# host. Required when QLLAW_FONT_POLICY=required. The path must contain
# times.ttf, timesbd.ttf, timesi.ttf, timesbi.ttf with the exact
# "Times New Roman" family metadata. NEVER copy or commit the fonts.
QLLAW_TNR_FONT_DIR=/srv/qllaw/fonts/times-new-roman

# Optional: Swagger docs on staging. Keep false in production.
SWAGGER_ENABLED=false

# ----- Web container -----
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://your-api-domain.example/api/v1
