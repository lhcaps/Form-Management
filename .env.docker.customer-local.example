# Copy to .env.docker.customer-local. Never commit the copied file.
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=quanlyvks
MYSQL_USER=quanlyvks
MYSQL_PASSWORD=replace-with-strong-db-password
NODE_ENV=production
QLLAW_DOCKER_ENV_FILE=.env.docker.customer-local
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3000
API_CORS_ORIGIN=http://127.0.0.1:3000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CLERK_SECRET_KEY=replace-with-sk_test-key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-pk_test-key
CLERK_WEBHOOK_SECRET=
SEED_ADMIN_PASSWORD=replace-with-strong-bootstrap-password
SEED_LE_HUY_PASSWORD=replace-with-strong-bootstrap-password
SEED_LE_HUY_EMAIL=customer@example.com
SEED_LE_HUY_CLERK_USER_ID=user_replace_with_new_customer_clerk_id
QLLAW_FONT_POLICY=required
QLLAW_REQUIRED_FONT_FAMILY=Times New Roman
QLLAW_TNR_FONT_DIR=C:/QLLaw/fonts/times-new-roman
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
SWAGGER_ENABLED=false
