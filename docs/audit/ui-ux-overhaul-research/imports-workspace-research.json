  "behavior": {
    "dropzone": {
      "accept": ".pdf,.docx,.doc,.xlsx,.xls,.csv,.txt,.json,.png,.jpg,.jpeg,.webp,.tif,.tiff",
      "max_files_per_drop": 20,
      "primary_cta_class": "bg-primary",
      "drag_handlers": ["onDragOver", "onDragLeave", "onDrop"],
      "uses_xhr_for_progress": true
    },
    "preview": {
      "table_kind_enum": ["text", "json", "table", "image", "binary"],
      "rendered": ["table", "json.preview", "previewText"],
      "column_mapping_field": "candidateColumns[].{id,columnName,mappedField,confidence}",
      "empty_cell_placeholder": "Trống"
    },
    "confirm": {
      "payload_type": "ConfirmImportPayload",
      "required_keys": ["targetType"],
      "optional_keys": ["note", "existingCaseId", "newCase", "createdByName"],
      "new_case_keys": ["caseCode", "caseTitle", "relatedPersonName", "offenseName", "createdDate"],
      "endpoint": "POST /import/batches/{batchId}/confirm",
      "history_helper_args": [1, 12]
    },
    "history": {
      "endpoint": "GET /import/history?page=&pageSize=",
      "default_call": "getImportHistory(1, 12)",
      "pagination_in_ui": false,
      "shape": "grid (md:2 xl:3)"
    },
    "status": {
      "enum": [
        "UPLOADED",
        "PARSED",
        "PARTIAL",
        "FAILED",
        "CONFIRMED",
        "STORED_ONLY",
        "PARSED_WITH_WARNINGS",
        "REJECTED"
      ],
      "confidence_enum": ["cao", "vừa", "thấp"]
    },
    "auth": {
      "guard_in_route": false,
      "auth_helper": "readApi (withCredentials)",
      "session_cookie_required": true,
      "qlv_session_used": false
    }
  },
