{
  "name": "@qllaw/form-contracts",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "require": "./dist/browser.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/browser.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts src/adapters/*.test.ts",
    "lint": "tsc --noEmit",
    "contract:validate": "tsx scripts/validate-contracts.ts",
    "contract:compile": "tsx scripts/compile-contracts.ts",
    "audit:contract-sync": "tsx scripts/audit-contract-sync.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
